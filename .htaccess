# ============================================================
# Crawlers this site welcomes.
# The host blocks known AI crawlers by setting a bad_bot flag at server level.
# Each line below clears that flag for one agent. Per hostns.io support,
# 30 September 2026.
#
# Deliberately NOT included: their template began with
#   SetEnvIfNoCase User-Agent .*.* !bad_bot
# which matches every agent and would switch the protection off completely.
# Only the agents named here are let through.
# ============================================================

# Answer engines and AI assistants
SetEnvIfNoCase User-Agent .*GPTBot.*            !bad_bot
SetEnvIfNoCase User-Agent .*OAI-SearchBot.*     !bad_bot
SetEnvIfNoCase User-Agent .*ChatGPT-User.*      !bad_bot
SetEnvIfNoCase User-Agent .*ChatGPT.*           !bad_bot
SetEnvIfNoCase User-Agent .*OpenAI.*            !bad_bot
SetEnvIfNoCase User-Agent .*ClaudeBot.*         !bad_bot
SetEnvIfNoCase User-Agent .*Claude-User.*       !bad_bot
SetEnvIfNoCase User-Agent .*Claude-SearchBot.*  !bad_bot
SetEnvIfNoCase User-Agent .*anthropic-ai.*      !bad_bot
SetEnvIfNoCase User-Agent .*PerplexityBot.*     !bad_bot
SetEnvIfNoCase User-Agent .*Perplexity-User.*   !bad_bot
SetEnvIfNoCase User-Agent .*Perplexity.*        !bad_bot
SetEnvIfNoCase User-Agent .*GrokBot.*           !bad_bot
SetEnvIfNoCase User-Agent .*Google-Extended.*   !bad_bot
SetEnvIfNoCase User-Agent .*Applebot-Extended.* !bad_bot
SetEnvIfNoCase User-Agent .*Amazonbot.*         !bad_bot
SetEnvIfNoCase User-Agent .*cohere-ai.*         !bad_bot
SetEnvIfNoCase User-Agent .*Meta-ExternalAgent.* !bad_bot
SetEnvIfNoCase User-Agent .*CCBot.*             !bad_bot
SetEnvIfNoCase User-Agent .*YouBot.*            !bad_bot
SetEnvIfNoCase User-Agent .*Diffbot.*           !bad_bot
SetEnvIfNoCase User-Agent .*Timpibot.*          !bad_bot

# SEO tools, so this site can be audited
SetEnvIfNoCase User-Agent .*Screaming\ Frog\ SEO\ Spider.* !bad_bot
SetEnvIfNoCase User-Agent .*AhrefsBot.*         !bad_bot
SetEnvIfNoCase User-Agent .*Ahrefs.*            !bad_bot
SetEnvIfNoCase User-Agent .*SemrushBot.*        !bad_bot
SetEnvIfNoCase User-Agent .*Semrush.*           !bad_bot

# AWS Explained Simply

# ---------- the front door ----------
DirectoryIndex index.html

# ---------- canonical host and scheme ----------
<IfModule mod_rewrite.c>
  RewriteEngine On

  # always https
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^(.*)$ https://aws.4bittechnology.com/$1 [R=301,L]

  # always the bare host, never www
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^(.*)$ https://aws.4bittechnology.com/$1 [R=301,L]

  # one URL per page: /index.html is the same page as /
  RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
  RewriteRule ^index\.html$ / [R=301,L]

  # the services list used to live at /index.html before basics became the front door
  RewriteRule ^basics\.html$ / [R=301,L]
</IfModule>

# ---------- correct types ----------
<IfModule mod_mime.c>
  AddType image/svg+xml            .svg
  AddType application/json         .json
  AddType text/plain               .txt
  AddType application/xml          .xml
  AddType application/manifest+json .webmanifest
</IfModule>

# ---------- compression ----------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml text/javascript
  AddOutputFilterByType DEFLATE application/javascript application/json application/xml
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/css text/javascript
  AddOutputFilterByType BROTLI_COMPRESS application/javascript application/json image/svg+xml
</IfModule>

# ---------- caching ----------
# every css and js link carries a content hash, so they are safe to cache hard.
# html and data must stay fresh.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css                  "access plus 1 year"
  ExpiresByType application/javascript    "access plus 1 year"
  ExpiresByType image/svg+xml             "access plus 1 year"
  ExpiresByType image/png                 "access plus 1 year"
  ExpiresByType text/html                 "access plus 10 minutes"
  ExpiresByType application/json          "access plus 1 hour"
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|svg|png|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=600, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.json$">
    Header set Cache-Control "public, max-age=3600"
  </FilesMatch>

  # ---------- security ----------
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), interest-cohort=()"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  # no third party scripts on this site, only Google Fonts stylesheets and font files
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'"
</IfModule>

# ---------- do not serve the workings ----------
<FilesMatch "\.(py|sh|bak|log)$">
  Require all denied
</FilesMatch>
<Files ".htaccess">
  Require all denied
</Files>

ErrorDocument 404 /404.html
